# Copy to .env.local and fill in.

# Password for the gate in front of the archive. Consumed at BUILD time by
# vite.config.ts, which ships a salted SHA-256 digest to the browser rather than
# the password itself. Changing it and rebuilding invalidates every prior unlock.
#
# On Vercel: set ARCHIVE_PASSWORD as a project Environment Variable and redeploy
# (a rebuild is required — it is not read at runtime).
ARCHIVE_PASSWORD=
