# Copy to .env.local and fill in.
#
# Both passwords are consumed at BUILD time by vite.config.ts, which ships
# salted SHA-256 digests to the browser rather than the passwords themselves.
# Changing one and rebuilding invalidates every unlock issued under it.
#
# On Vercel: set these as project Environment Variables and redeploy (a rebuild
# is required — they are not read at runtime).

# Public password. Opens only the days listed in ALLOWED_DATES (src/config.ts),
# each trimmed to its own clock window.
ARCHIVE_PASSWORD=

# Admin password. Opens the ENTIRE archive — every day, every hour — ignoring
# ALLOWED_DATES. Keep it different from ARCHIVE_PASSWORD, or the public
# password grants admin access too.
ADMIN_PASSWORD=
